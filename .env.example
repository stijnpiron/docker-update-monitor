# Docker Hub credentials
# Preferred auth: use a Personal Access Token (PAT) instead of your password.
# Generate one at: https://app.docker.com/settings/personal-access-tokens
DOCKERHUB_USERNAME=myusername
DOCKERHUB_PASSWORD=my_personal_access_token

# GitHub PAT with read:packages scope — needed for ghcr.io images
# Generate one at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Docker socket GID (find with: stat -c '%g' /var/run/docker.sock)
DOCKER_GID=999

# --- Multi-host scanning over SSH (optional) ---
# Scan remote Docker daemons in addition to the local one. Leave DOCKER_HOSTS
# unset (the default below) to keep scanning only the local socket — behavior
# is unchanged and no SSH connection is attempted.
#
# Format: comma-separated "name=ssh://user@host" pairs. Each name must match a
# `Host <alias>` block in the OpenSSH config mounted into the container (see
# docker-compose.yml), where that alias points at its per-host key. One
# read-only key per host is mounted as a Docker secret (also in
# docker-compose.yml) and must be readable by the `nobody` user (chmod 644).
# Re-enable here AND in docker-compose.yml (environment + volumes + secrets)
# to use multi-host mode:
#
# DOCKER_HOSTS=prod=ssh://monitor@prod-host,nas=ssh://monitor@nas-host
#
# How often, at most, to re-fire a host down/recovered alert for a flapping
# host. Accepted formats: "0", "30m", "1h", "2d", "1w" (default "1h").
#
# HOST_REACH_COOLDOWN=1h
